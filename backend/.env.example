# Backend Railway Environment Variables Template (Aiven MySQL Deployment)

# Dynamic Railway Port (automatically injected by Railway)
PORT=9090

# Production Aiven MySQL Database Connection URL
# Example: jdbc:mysql://mysql-2b5a123-your-aiven-host.aivencloud.com:28336/defaultdb?sslmode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<AIVEN_DB>?sslmode=REQUIRED

# Aiven MySQL Database Credentials
DB_USERNAME=avnadmin
DB_PASSWORD=<YOUR_AIVEN_MYSQL_PASSWORD>

# JWT Authentication Secret Key
JWT_SECRET=change-this-production-secret-key-to-a-very-long-random-string-123456789
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated Vercel Frontend URLs)
CORS_ALLOWED_ORIGINS=https://alpha-jewels.vercel.app,http://localhost:5173
