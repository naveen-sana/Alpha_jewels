# Backend Environment Variables Example (Render / Production Deployment)

# Server Port (Injected automatically by Render, default fallback is 9090)
PORT=9090

# Database Configuration (Aiven PostgreSQL)
# Option 1: Full DATABASE_URL or SPRING_DATASOURCE_URL
DATABASE_URL=jdbc:postgresql://your-aiven-db-host.aivencloud.com:25363/defaultdb?sslmode=require
# Option 2: Individual variables
DB_HOST=your-aiven-db-host.aivencloud.com
DB_PORT=25363
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# Hibernate DDL Auto (update, validate, or none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Authentication Secret & Expiration
JWT_SECRET=your-long-random-jwt-secret-key-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of deployed frontend URLs)
CORS_ALLOWED_ORIGINS=https://alpha-jewels.vercel.app,http://localhost:5173

# Mail Service Credentials (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
